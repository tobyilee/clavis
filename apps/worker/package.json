{
  "name": "@clavis/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@clavis/shared": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  }
}
