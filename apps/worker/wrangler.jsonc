{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clavis",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/files/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clavis",
      "database_id": "970ba8a5-a082-4aa0-814d-7a0ae3b2804a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "clavis-files" }],
  // Per-key API limit (S7). Permissive and per-location by design: it stops runaway
  // agents, it is not an accounting system.
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  // Chunked nightly backup (D-30): every 2 min, 17:00-18:58 UTC = 02:00-03:58 KST (60 runs)
  "triggers": { "crons": ["*/2 17-18 * * *"] },
  "vars": {
    "APP_VERSION": "0.0.0",
    // Cloudflare Access (D-05): public identifiers used to verify the Cf-Access-Jwt-Assertion JWT.
    "ACCESS_TEAM_DOMAIN": "https://red-voice-3160.cloudflareaccess.com",
    "ACCESS_AUD": "ad5290676f1e5594abd4f7e92d3e30582c0ae7f99f65b98a5781f89226f6b987"
  },
  "observability": { "enabled": true }
}
