# Copy to .agent.env (git-ignored) and fill in. Credentials for calling the production Worker
# as an agent (MCP, REST, raw Markdown). Coding, tests and CI deploys do not need them.
#
#   cp .agent.env.example .agent.env && chmod 600 .agent.env
#
# Never `source` or print this file: a line like `KEY= value` makes the shell run `value` as a
# command and echo it in the error. Load it with:
#
#   eval "$(python3 scripts/agent-env.py)"
#
# One KEY=value per line. Quotes and the "CF-Access-Client-Id: " prefix the Cloudflare
# dashboard shows are tolerated.

# Cloudflare Access service token (Zero Trust → Service Tokens): admits the request at the edge.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Clavis API tokens (clv_…), one per agent. `pnpm --filter @clavis/worker agent:create --name <name>`
# adds CLAVIS_TOKEN_<NAME> here; paste tokens issued in Admin → AI agents by hand.
CLAVIS_TOKEN_HERMES=

# Optional: Cloudflare API token for wrangler against production (e.g. CPU measurement).
# Left commented out, because an empty value would still be exported.
# CLOUDFLARE_API_TOKEN=
